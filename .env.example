# ---- Gemini (optional) ---------------------------------------------------
# Enables LLM intent understanding, Gemini-steered merchant moves (still
# clamped by policy) and narrated recommendations. Without it, deterministic
# policy agents and a rules parser run instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# GEMINI_THINKING_LEVEL=LOW
# NEXUS_AGENT_MODE=policy        # keep Gemini for intent/narration only

# ---- PayPal Sandbox (optional) -------------------------------------------
# Without these, checkout runs through the built-in payment simulator.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Route a merchant's payments to its own sandbox business account:
# PAYPAL_PAYEE_EMAIL_BOLT=bolt@business.example.com
# NEXUS_REQUIRE_WEBHOOK=true     # confirm only after a verified webhook

# ---- Merchant workspace ----------------------------------------------------
# Passcodes for the role-restricted merchant workspace (/merchant). In
# development, unset merchants fall back to the passcode "nexus-dev"; in
# production that fallback is disabled and sign-in fails without these.
NEXUS_MERCHANT_PASSCODE_ATELIER=
NEXUS_MERCHANT_PASSCODE_BOLT=
NEXUS_MERCHANT_PASSCODE_COVE=

# ---- Nexus ---------------------------------------------------------------
NEXUS_SIGNING_SECRET=            # HMAC key for agreements (random per process if unset)
NEXUS_PACE_MS=380                # delay between negotiation events in the live room

# ---- Supabase (optional) ---------------------------------------------------
# Project URL and publishable key (Project Settings → API). The publishable key
# is safe in the browser; it can only do what row-level security allows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key, for writing sessions, orders and the security ledger.
# Never expose it to the browser and never commit it.
SUPABASE_SECRET_KEY=
